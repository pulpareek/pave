  "department": "clinical-dev",
  "data_classification": "confidential",
  "environment": "prod",
  "region": "us-east-1",
  "data_retention": "7y",
  "cost_center": "CC-4500",
  "cost_type": "opex",
  "budget_monthly_cap": 2500,
  "lifecycle_stage": "pilot",
  "sla_tier": "tier2",
  "rto_hours": 8,
  "rpo_hours": 4,
  "security_review_status": "approved",
  "ai_risk_tier": "limited",

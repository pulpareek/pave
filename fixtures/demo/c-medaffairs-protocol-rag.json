  "human_oversight": true,
  "resources": [
    {
      "type": "llm_gateway_endpoint",
      "config": {
        "provider": "databricks",
        "model": "databricks-claude-sonnet-4",
        "task": "llm/v1/chat",
        "guardrails": [
          "pii_redact",
          "safety"
        ],
        "throughput_mode": "pay_per_token",
        "rate_limit_qpm": 100,
        "rate_limit_tpm": 50000,
        "monthly_token_budget": 5000000,
        "monthly_cost_cap_usd": 2000,
        "inference_logging": true
      }
    },
    {
      "type": "vector_search",
      "config": {
        "index_type": "DELTA_SYNC",
        "embedding_source": "managed",
        "pipeline_type": "TRIGGERED",
        "embedding_model": "databricks-gte-large-en",
        "source_table": "clinical.protocols.approved_docs"
      }
    },
    {
      "type": "schema",
